{
  "$schema": "http://json.schemastore.org/template",
  "specialCustomOperations": {
    "**.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "actionableIf": [ "<!--#if" ],
            "actionableElse": [ "#else", "<!--#else" ],
            "actionableElseif": [ "#elseif", "<!--#elseif", "#elif", "<!--#elif" ],
            "endif": [ "#endif", "<!--#endif" ],
            "trim" : "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        },
        {
          "type": "balancednesting",
          "configuration": {
            "startToken": "<!--",
            "realEndToken": "-->",
            "pseudoEndToken": "-- >",
            "id": "fixPseudoNestedComments",
            "resetFlag": "_TestResetFlag_"
          }
        }
      ]
    }
  },
  "author": "Nocco Giovanni Emanuele",
  "classifications": [
    "Web/ASP.NET"
  ],
  "name": "Genocs: Microservice Template",
  "identity": "Genocs.Microservice.Template",
  "description": "Clean Architecture Microservice Template built with Multitenancy Support.",
  "groupIdentity": "Genocs.Template",
  "shortName": "gnx-microservice",
  "tags": {
    "type": "solution",
    "language": "C#"
  },
  "sourceName": "Genocs.Microservice.Template",
  "preferNameDirectory": true,
  "symbols": {
    "use-cases": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "full",
      "choices": [
        {
          "choice": "full",
          "description": "Setup the full set of functionalities"
        }
      ],
      "replaces": "use-cases",
      "onlyIf": [
        {
          "after": "\"use-cases\": \""
        }
      ]
    },
    "full": {
      "type": "computed",
      "value": "(use-cases == \"full\")"
    },
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "mssql",
      "description": "Database provider. Exactly one provider is included.",
      "choices": [
        {
          "choice": "mssql",
          "description": "SQL Server Database (MSSQL)"
        },
        {
          "choice": "postgresql",
          "description": "PostgreSQL Database (PostgreSQL)"
        },
        {
          "choice": "mysql",
          "description": "MySQL Database (MySQL)"
        },
        {
          "choice": "oracle",
          "description": "Oracle Database (Oracle)"
        },
        {
          "choice": "sqlite",
          "description": "SQLite Database (SQLite)"
        }
      ]
    },
    "MSSQL": {
      "type": "computed",
      "value": "(database == \"mssql\")"
    },
    "PostgreSQL": {
      "type": "computed",
      "value": "(database == \"postgresql\")"
    },
    "MySQL": {
      "type": "computed",
      "value": "(database == \"mysql\")"
    },
    "Oracle": {
      "type": "computed",
      "value": "(database == \"oracle\")"
    },
    "SQLite": {
      "type": "computed",
      "value": "(database == \"sqlite\")"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        ".idea/**",
        ".vs/**",
        "media/**"
      ],      
      "modifiers": [
        {
          "condition": "(full)",
          "exclude": []
        },
        {
          "condition": "(MSSQL)",
          "exclude": [
            "src/Migrators.MySQL/**/*.*",
            "src/Migrators.Oracle/**/*.*",
            "src/Migrators.PostgreSQL/**/*.*",
            "src/Migrators.SqLite/**/*.*",
            "infrastructure/containers/docker-compose-infrastructure.mysql.yml",
            "infrastructure/containers/docker-compose-infrastructure.postgresql.yml"
          ]
        },
        {
          "condition": "(PostgreSQL)",
          "exclude": [
            "src/Migrators.MSSQL/**/*.*",
            "src/Migrators.MySQL/**/*.*",
            "src/Migrators.Oracle/**/*.*",
            "src/Migrators.SqLite/**/*.*",
            "infrastructure/containers/docker-compose-infrastructure.mssql.yml",
            "infrastructure/containers/docker-compose-infrastructure.mysql.yml"
          ]
        },
        {
          "condition": "(MySQL)",
          "exclude": [
            "src/Migrators.MSSQL/**/*.*",
            "src/Migrators.Oracle/**/*.*",
            "src/Migrators.PostgreSQL/**/*.*",
            "src/Migrators.SqLite/**/*.*",
            "infrastructure/containers/docker-compose-infrastructure.mssql.yml",
            "infrastructure/containers/docker-compose-infrastructure.postgresql.yml"
          ]
        },
        {
          "condition": "(Oracle)",
          "exclude": [
            "src/Migrators.MSSQL/**/*.*",
            "src/Migrators.MySQL/**/*.*",
            "src/Migrators.PostgreSQL/**/*.*",
            "src/Migrators.SqLite/**/*.*",
            "infrastructure/containers/docker-compose-infrastructure.mssql.yml",
            "infrastructure/containers/docker-compose-infrastructure.mysql.yml",
            "infrastructure/containers/docker-compose-infrastructure.postgresql.yml"
          ]
        },
        {
          "condition": "(SQLite)",
          "exclude": [
            "src/Migrators.MSSQL/**/*.*",
            "src/Migrators.MySQL/**/*.*",
            "src/Migrators.Oracle/**/*.*",
            "src/Migrators.PostgreSQL/**/*.*",
            "infrastructure/containers/docker-compose-infrastructure.mssql.yml",
            "infrastructure/containers/docker-compose-infrastructure.mysql.yml",
            "infrastructure/containers/docker-compose-infrastructure.postgresql.yml"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    {
      "path": "./"
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}