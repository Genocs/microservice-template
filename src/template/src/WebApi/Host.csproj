<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Genocs.Microservice.Template.WebApi</RootNamespace>
        <AssemblyName>Genocs.Microservice.Template.WebApi</AssemblyName>
        <IsPackable>false</IsPackable>
        <UserSecretsId>Genocs</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- This package is used to handle EF migrations -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <!-- These packages are needed to resolve the issue related to Include="RazorEngineCore" Version="2024.4.1" -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    </ItemGroup>

    <ItemGroup Label="Genocs library">
        <PackageReference Include="Genocs.Logging" Version="9.2.0-beta02" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Migrators.MySQL\Migrators.MySQL.csproj" />
        <ProjectReference Include="..\Migrators.Oracle\Migrators.Oracle.csproj" />
        <ProjectReference Include="..\Migrators.PostgreSQL\Migrators.PostgreSQL.csproj" />
        <ProjectReference Include="..\Migrators.MSSQL\Migrators.MSSQL.csproj" />
        <ProjectReference Include="..\Migrators.SqLite\Migrators.SqLite.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Application\Application.csproj" />
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="Configurations\*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Include="Logs\*" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Email Templates\*.cshtml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="Databases\**" />
        <None Remove="Databases\**" />
    </ItemGroup>

    <ItemGroup>
        <None Update="certs\cert.pfx">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Files\placeholder.txt">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>